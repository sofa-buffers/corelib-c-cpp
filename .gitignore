# Build directories, at the repo root only. Unanchored these also matched any
# path component starting with "build-" — which silently kept
# utils/ci/build-config.sh out of the repository.
/build
/build-*

# Local secrets — never commit
.env

# Claude Code tooling. The pattern matches the direct children rather than
# ".claude/" itself: an excluded *directory* is never descended into, so a later
# "!.claude/skills/" would have no file to re-include. Worktrees and local
# settings stay out; the shared skills are part of the repository.
.claude/*
!.claude/skills/
